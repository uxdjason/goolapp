---
import { getEntry, render, getCollection } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import RelatedApps from '../../components/RelatedApps.astro';

const entry = await getEntry('apps', 'barcode-generator');
if (!entry) throw new Error('barcode-generator entry not found');
const { Content } = await render(entry);

const allApps = await getCollection('apps');
let related = allApps
  .filter(app => entry.data.relatedSlugs?.includes(app.data.slug))
  .map(app => ({ title: app.data.title, shortDescription: app.data.shortDescription, slug: app.data.slug, category: app.data.category }));
if (related.length === 0) {
  related = allApps
    .filter(app => app.data.slug !== entry.data.slug)
    .slice(0, 3)
    .map(app => ({ title: app.data.title, shortDescription: app.data.shortDescription, slug: app.data.slug, category: app.data.category }));
}
---

<AppLayout
  title={entry.data.title}
  description={entry.data.seo.description}
  shortDescription={entry.data.shortDescription}
  category={entry.data.category}
  keywords={entry.data.seo.secondaryKeywords}
  ogImage={entry.data.seo.ogImage}
  ogTitle={entry.data.seo.ogTitle}
  ogDescription={entry.data.seo.ogDescription}
  canonicalUrl={`https://goolapp.com${entry.data.seo.canonicalPath}`}
  publishedAt={entry.data.publishedAt}
>
  <Fragment slot="app">
    <div class="app-calc-layout">
      <div class="app-form-group">
        <label class="app-label" for="formatSelect">
          바코드 형식 <span class="required">*</span>
        </label>
        <select id="formatSelect" class="app-input" style="margin-bottom: 1rem;">
          <option value="CODE128">CODE128 (범용: 영문/숫자/특수문자)</option>
          <option value="CODE39">CODE39 (산업용: 영문 대문자/숫자)</option>
          <option value="EAN13">EAN-13 (상품용: 숫자 12자리)</option>
        </select>

        <label class="app-label" for="textInput">
          바코드 데이터 <span class="required">*</span>
        </label>
        <input
          id="textInput"
          type="text"
          class="app-input"
          placeholder="영문·숫자·특수문자 1~30자"
          maxlength="30"
          autocomplete="off"
        />
        <p class="hint">ASCII 출력 가능 문자(영문, 숫자, 공백, 특수문자)만 최대 30자까지 입력할 수 있습니다.</p>

        <label class="app-label" for="labelInput" style="margin-top: 1rem;">
          바코드 레이블 <span class="optional">(선택)</span>
        </label>
        <input
          id="labelInput"
          type="text"
          class="app-input"
          placeholder="바코드 아래에 표시할 텍스트"
          autocomplete="off"
        />

        <div class="actions">
          <button id="generateBtn" type="button" class="app-btn app-btn-primary">
            바코드 생성
          </button>
          <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
            <button id="savePngBtn" type="button" class="app-btn app-btn-secondary" style="flex: 1;" hidden>
              PNG 저장
            </button>
            <button id="saveSvgBtn" type="button" class="app-btn app-btn-secondary" style="flex: 1;" hidden>
              SVG 저장
            </button>
          </div>
        </div>

        <p id="errorMsg" class="error-msg" hidden></p>
      </div>

      <div class="result-section" id="resultSection" hidden style="min-height: 200px;">
        <h3 class="result-title">생성된 바코드</h3>
        <div id="barcodeContainer" class="barcode-container"></div>
      </div>

      <div class="qr-notice" style="text-align: center; margin-top: 1rem; font-size: 0.9rem; color: var(--color-on-surface-variant);">
        ※ 한글이나 URL을 담으려면 <a href="/qr-code-generator/" style="color: var(--color-primary); text-decoration: underline; font-weight: 600;">QR 코드 생성기</a>를 이용하세요.
      </div>

      <div class="empty-state" id="emptyState">
        <div class="empty-icon">▭▭▭</div>
        <p>위에 바코드로 만들 데이터를 입력한 후<br/>"바코드 생성" 버튼을 눌러주세요.</p>
      </div>
    </div>
  </Fragment>

  <Fragment slot="longform">
    <Content />
    <RelatedApps apps={related} />
  </Fragment>
</AppLayout>

<style>
  /* barcode-generator 특화 스타일 */
  .required {
    color: var(--color-danger);
    font-weight: 700;
  }

  .optional {
    color: var(--color-on-surface-variant);
    font-weight: 400;
    font-size: 0.85rem;
  }

  .hint {
    font-size: 0.8rem;
    color: var(--color-on-surface-variant);
    margin: 0;
    font-family: var(--font-family-gothic);
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .error-msg {
    color: var(--color-error);
    background: var(--color-error-container);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    margin: 0;
    font-size: 0.9rem;
    font-family: var(--font-family-gothic);
  }

  .error-msg[hidden] {
    display: none;
  }

  .result-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-outline-variant);
  }

  .result-section[hidden] {
    display: none;
  }

  .result-title {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-on-surface);
    font-family: var(--font-family-gothic);
  }

  .barcode-container {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #ffffff;
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-outline-variant);
    max-width: 100%;
    overflow-x: auto;
  }

  .barcode-container :global(canvas) {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    color: var(--color-on-surface-variant);
    border: 2px dashed var(--color-outline-variant);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-family: var(--font-family-gothic);
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-icon {
    font-size: 2rem;
    letter-spacing: 0.2em;
    color: var(--color-outline-variant);
    margin-bottom: 0.75rem;
  }

  .empty-state p {
    margin: 0;
    line-height: 1.6;
  }
</style>

<script>
  // JsBarcode 라이브러리 CDN 로드 (CODE128 바코드 렌더링용)
  // 추후 npm 패키지화 가능: npm install jsbarcode
  const JSBARCODE_CDN = 'https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js';

  function loadJsBarcode(): Promise<any> {
    return new Promise((resolve, reject) => {
      if ((window as any).JsBarcode) {
        resolve((window as any).JsBarcode);
        return;
      }
      const existing = document.querySelector(`script[src="${JSBARCODE_CDN}"]`);
      if (existing) {
        existing.addEventListener('load', () => resolve((window as any).JsBarcode));
        existing.addEventListener('error', reject);
        return;
      }
      const script = document.createElement('script');
      script.src = JSBARCODE_CDN;
      script.async = true;
      script.onload = () => resolve((window as any).JsBarcode);
      script.onerror = () => reject(new Error('JsBarcode 로드 실패'));
      document.head.appendChild(script);
    });
  }

  const formatSelect = document.getElementById('formatSelect') as HTMLSelectElement;
  const textInput = document.getElementById('textInput') as HTMLInputElement;
  const labelInput = document.getElementById('labelInput') as HTMLInputElement;
  const generateBtn = document.getElementById('generateBtn') as HTMLButtonElement;
  const savePngBtn = document.getElementById('savePngBtn') as HTMLButtonElement;
  const saveSvgBtn = document.getElementById('saveSvgBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLParagraphElement;
  const resultSection = document.getElementById('resultSection') as HTMLDivElement;
  const emptyState = document.getElementById('emptyState') as HTMLDivElement;
  const barcodeContainer = document.getElementById('barcodeContainer') as HTMLDivElement;

  const ASCII_RE = /^[\x20-\x7E]{1,30}$/;
  const CODE39_RE = /^[A-Z0-9\-\.\ \$\/\+\%]{1,30}$/;
  const EAN13_RE = /^\d{12,13}$/;
  
  let generatedSvgString = '';

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorMsg.hidden = false;
  }

  function clearError() {
    errorMsg.textContent = '';
    errorMsg.hidden = true;
  }

  async function generateBarcode() {
    clearError();
    const text = textInput.value.trim();
    const label = labelInput.value.trim();

    if (!text) {
      showError('바코드 데이터를 입력해주세요.');
      return;
    }
    
    const format = formatSelect.value;
    if (format === 'CODE128' && !ASCII_RE.test(text)) {
      showError('CODE128은 영문·숫자·특수문자(ASCII) 1~30자만 지원합니다.');
      return;
    } else if (format === 'CODE39' && !CODE39_RE.test(text)) {
      showError('CODE39는 영문 대문자, 숫자, 일부 특수문자(-.$/+%)만 지원합니다.');
      return;
    } else if (format === 'EAN13' && !EAN13_RE.test(text)) {
      showError('EAN-13은 12자리 또는 13자리 숫자만 지원합니다.');
      return;
    }

    let JsBarcode: any;
    try {
      JsBarcode = await loadJsBarcode();
    } catch (e) {
      showError('바코드 라이브러리를 불러오지 못했습니다. 네트워크를 확인해 주세요.');
      return;
    }

    try {
      // 임시 캔버스에 바코드 그리기
      const tempCanvas = document.createElement('canvas');
      JsBarcode(tempCanvas, text, {
        format: format,
        width: 2,
        height: 100,
        displayValue: false,
        margin: 10,
        background: '#ffffff',
      });

      // 최종 캔버스에 바코드 + 텍스트 + 레이블 합성
      const finalCanvas = document.createElement('canvas');
      finalCanvas.width = tempCanvas.width;
      finalCanvas.height = tempCanvas.height + 50;
      const ctx = finalCanvas.getContext('2d')!;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, finalCanvas.width, finalCanvas.height);
      ctx.drawImage(tempCanvas, 0, 0);

      const centerX = finalCanvas.width / 2;
      ctx.textAlign = 'center';
      ctx.fillStyle = '#000000';
      ctx.font = 'bold 16px sans-serif';
      ctx.fillText(text, centerX, tempCanvas.height + 20);

      if (label !== '') {
        ctx.fillStyle = '#555555';
        ctx.font = '14px sans-serif';
        ctx.fillText(label, centerX, tempCanvas.height + 40);
      }

      barcodeContainer.innerHTML = '';
      barcodeContainer.appendChild(finalCanvas);

      // SVG 생성 (다운로드용)
      const svgEl = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      JsBarcode(svgEl, text, {
        format: format,
        width: 2,
        height: 100,
        displayValue: true,
        text: label ? `${text} (${label})` : text,
        margin: 10,
        background: '#ffffff',
      });
      generatedSvgString = new XMLSerializer().serializeToString(svgEl);

      emptyState.hidden = true;
      resultSection.hidden = false;

      setTimeout(() => {
        savePngBtn.hidden = false;
        saveSvgBtn.hidden = false;
      }, 200);
    } catch (e) {
      console.error(e);
      showError('바코드 생성 중 오류가 발생했습니다. 입력값을 확인해주세요.');
    }
  }

  function savePng() {
      const canvas = barcodeContainer.querySelector('canvas') as HTMLCanvasElement | null;
      if (!canvas) {
        showError('저장할 바코드가 없습니다. 먼저 바코드를 생성해주세요.');
        return;
      }
      try {
        const dataURL = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = dataURL;
        a.download = 'barcode.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (e) {
        showError('PNG 저장 중 오류가 발생했습니다.');
      }
    }
  
    function saveSvg() {
      if (!generatedSvgString) {
        showError('저장할 바코드가 없습니다.');
        return;
      }
      try {
        const blob = new Blob([generatedSvgString], { type: 'image/svg+xml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'barcode.svg';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } catch (e) {
        showError('SVG 저장 중 오류가 발생했습니다.');
      }
    }

  generateBtn.addEventListener('click', generateBarcode);
  savePngBtn.addEventListener('click', savePng);
  saveSvgBtn.addEventListener('click', saveSvg);

  textInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      generateBarcode();
    }
  });
  labelInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      generateBarcode();
    }
  });
</script>