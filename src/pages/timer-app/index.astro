---
import { getEntry, render, getCollection } from "astro:content";
import AppLayout from "../../layouts/AppLayout.astro";
import RelatedApps from "../../components/RelatedApps.astro";

const entry = await getEntry("apps", "timer-app");
if (!entry) {
  throw new Error("timer-app app entry not found");
}
const { Content } = await render(entry);

const allApps = await getCollection("apps");
let related = allApps
  .filter((app) => entry.data.relatedSlugs?.includes(app.data.slug))
  .map((app) => ({
    title: app.data.title,
    shortDescription: app.data.shortDescription,
    slug: app.data.slug,
    category: app.data.category,
  }));

if (related.length === 0) {
  related = allApps
    .filter((app) => app.data.slug !== entry.data.slug)
    .slice(0, 3)
    .map((app) => ({
      title: app.data.title,
      shortDescription: app.data.shortDescription,
      slug: app.data.slug,
      category: app.data.category,
    }));
}
---

<AppLayout
  title={entry.data.title}
  description={entry.data.seo.description}
  shortDescription={entry.data.shortDescription}
  category={entry.data.category}
  keywords={entry.data.seo.secondaryKeywords}
  ogImage={entry.data.seo.ogImage}
  ogTitle={entry.data.seo.ogTitle}
  ogDescription={entry.data.seo.ogDescription}
  canonicalUrl={`https://goolapp.com${entry.data.seo.canonicalPath}`}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
>
  <Fragment slot="app">
    <div class="app-calc-layout">
      <!-- Tab Navigation -->
      <div class="app-tab-nav">
        <button class="app-tab-btn active" data-target="countdown">카운트다운</button>
        <button class="app-tab-btn" data-target="stopwatch">스톱워치</button>
        <div class="tab-nav-actions">
          <label class="sound-toggle" title="소리 알림">
            <input type="checkbox" id="sound-enabled" checked />
            <span>🔔</span>
          </label>
          <button id="fullscreen-btn" class="fullscreen-btn" title="전체화면">
            <svg id="fs-icon-expand" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
            <svg id="fs-icon-compress" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="10" y1="14" x2="3" y2="21"></line><line x1="21" y1="3" x2="14" y2="10"></line></svg>
          </button>
        </div>
      </div>

      <!-- Countdown View -->
      <div id="countdown-view" class="app-view">
        <div
          class="state-label"
          id="cd-state-label"
          style="visibility: hidden;"
        >
          남은 시간
        </div>

        <div class="input-section app-form-group" id="cd-inputs">
          <div class="time-inputs">
            <div class="time-input-group">
              <input type="number" id="cd-h" placeholder="0" min="0" max="99" />
              <span>시간</span>
            </div>
            <div class="colon">:</div>
            <div class="time-input-group">
              <input type="number" id="cd-m" placeholder="0" min="0" max="59" />
              <span>분</span>
            </div>
            <div class="colon">:</div>
            <div class="time-input-group">
              <input type="number" id="cd-s" placeholder="0" min="0" max="59" />
              <span>초</span>
            </div>
          </div>
        </div>

        <div class="controls">
          <button class="app-btn app-btn-secondary" id="cd-reset">초기화</button
          >
          <button class="app-btn app-btn-primary" id="cd-start">시작</button>
          <button
            class="app-btn app-btn-danger"
            id="cd-stop"
            style="display:none;">정지</button
          >
        </div>
      </div>

      <!-- Stopwatch View -->
      <div id="stopwatch-view" class="app-view" style="display:none;">
        <div class="state-label">진행 시간</div>
        <div class="time-display sw-text" id="sw-display">00:00:00.00</div>

        <div class="controls">
          <button class="app-btn app-btn-secondary" id="sw-reset">초기화</button
          >
          <button
            class="app-btn app-btn-secondary"
            id="sw-lap"
            style="display:none;">구간 기록</button
          >
          <button class="app-btn app-btn-primary" id="sw-start">시작</button>
          <button
            class="app-btn app-btn-danger"
            id="sw-stop"
            style="display:none;">정지</button
          >
        </div>

        <div
          class="lap-container app-form-group"
          id="lap-container"
          style="display:none;"
        >
          <ul id="lap-list" class="lap-list"></ul>
        </div>
      </div>

      <!-- 전체화면 오버레이 -->
      <div id="fullscreen-overlay" class="fullscreen-overlay" hidden>
        <div class="fs-time-display" id="fs-time">00:00</div>
        <div class="fs-label" id="fs-label">카운트다운</div>
        <button id="fs-exit-btn" class="fs-exit-btn" title="전체화면 종료">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="10" y1="14" x2="3" y2="21"></line><line x1="21" y1="3" x2="14" y2="10"></line></svg>
          <span>ESC 또는 클릭으로 종료</span>
        </button>
      </div>

      <!-- 공통 경고 모달 -->
      <div id="app-alert-modal" class="app-modal-overlay" hidden>
        <div class="app-modal">
          <div class="app-modal-icon">⚠️</div>
          <p class="app-modal-title" id="app-alert-title">알림</p>
          <p class="app-modal-body" id="app-alert-message"></p>
          <div class="app-modal-actions">
            <button id="app-alert-confirm-btn" class="app-btn app-btn-primary"
              >확인</button
            >
          </div>
        </div>
      </div>
    </div>
  </Fragment>

  <Fragment slot="longform">
    <div class="prose">
      <Content />
    </div>
    {related.length > 0 && <RelatedApps apps={related} />}
  </Fragment>
</AppLayout>

<style>
  .header {
    text-align: center;
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .header p {
    margin: 0;
    color: var(--color-on-surface-variant);
    font-size: var(--font-size-base);
  }

  .app-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeIn var(--transition-base);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .state-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-on-surface-variant);
    margin-bottom: -var(--space-4);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: var(--space-4);
  }

  .time-display {
    font-size: clamp(3rem, 10vw, 4rem);
    font-weight: var(--font-weight-bold);
    font-family: 'Courier New', Courier, monospace;
    margin: var(--space-6) 0;
    text-align: center;
    font-variant-numeric: tabular-nums;
    letter-spacing: 2px;
  }

  .cd-text {
    color: var(--color-primary);
  }

  .sw-text {
    color: var(--color-on-surface);
  }

  .sw-text {
    color: var(--color-on-surface);
  }

  .time-inputs {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
  }

  .time-input-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .time-input-group input {
    width: 80px;
    height: 80px;
    font-size: 32px;
    text-align: center;
    border: 1px solid var(--color-outline-variant);
    background: var(--color-surface-container-highest);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-on-surface);
    transition: var(--transition-fast);
  }

  .time-input-group input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .time-input-group input:focus::placeholder {
    color: transparent;
  }

  .time-input-group input:disabled {
    background: transparent;
    color: var(--color-primary);
    border-color: transparent;
    -webkit-text-fill-color: var(--color-primary);
    opacity: 1;
    box-shadow: none;
  }

  .time-input-group span {
    font-size: var(--font-size-sm);
    color: var(--color-on-surface-variant);
    font-weight: var(--font-weight-bold);
  }

  .colon {
    font-size: 32px;
    font-weight: var(--font-weight-bold);
    color: var(--color-on-surface-variant);
    margin-bottom: 28px; /* align with input center */
  }

  .controls {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-2);
    width: 100%;
  }

  .lap-container {
    margin-top: var(--space-6);
    max-height: 250px;
    overflow-y: auto;
    padding: var(--space-4) var(--space-6);
  }

  .lap-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.lap-item) {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface);
    font-family: var(--font-family-base);
    font-variant-numeric: tabular-nums;
    width: 100%;
    font-size: var(--font-size-lg);
  }
  :global(.lap-item:last-child) {
    border-bottom: none;
  }

  /* Custom Scrollbar for lap container */
  .lap-container::-webkit-scrollbar {
    width: 8px;
  }
  .lap-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .lap-container::-webkit-scrollbar-thumb {
    background: var(--color-outline-variant);
    border-radius: 4px;
  }

  .app-tab-nav {
    display: flex;
    align-items: center;
  }

  .tab-nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sound-toggle {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 1.2rem;
    opacity: 0.5;
    transition: opacity 0.15s;
    user-select: none;
  }
  .sound-toggle input { display: none; }
  .sound-toggle:has(input:checked) { opacity: 1; }

  .fullscreen-btn {
    background: none;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.5rem;
    cursor: pointer;
    color: var(--color-on-surface-variant);
    display: flex;
    align-items: center;
    transition: background 0.15s, color 0.15s;
  }
  .fullscreen-btn:hover {
    background: var(--color-surface-container-highest);
    color: var(--color-primary);
  }

  /* Fullscreen 오버레이 */
  .fullscreen-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }
  .fullscreen-overlay[hidden] { display: none; }

  .fs-time-display {
    font-size: clamp(4rem, 18vw, 14rem);
    font-weight: 700;
    font-family: 'Courier New', Courier, monospace;
    font-variant-numeric: tabular-nums;
    letter-spacing: 4px;
    color: #fff;
    text-align: center;
    line-height: 1;
  }

  .fs-label {
    font-size: clamp(1rem, 3vw, 2rem);
    color: rgba(255,255,255,0.5);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .fs-exit-btn {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    color: rgba(255,255,255,0.6);
    padding: 0.5rem 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
  }
  .fs-exit-btn:hover {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  @media (max-width: 768px) {
    .time-display {
      font-size: clamp(2.5rem, 12vw, 3rem);
    }
    .time-input-group input {
      width: 60px;
      height: 60px;
      font-size: 24px;
    }
    .colon {
      font-size: 24px;
      margin-bottom: 24px;
    }
    .controls {
      flex-wrap: wrap;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const appAlertModal = document.getElementById("app-alert-modal");
    const appAlertMessage = document.getElementById("app-alert-message");
    const appAlertConfirmBtn = document.getElementById("app-alert-confirm-btn");

    function showAlert(msg) {
      appAlertMessage.textContent = msg;
      appAlertModal.removeAttribute("hidden");
    }

    function hideAlert() {
      appAlertModal.setAttribute("hidden", "");
    }

    if (appAlertConfirmBtn)
      appAlertConfirmBtn.addEventListener("click", hideAlert);
    if (appAlertModal)
      appAlertModal.addEventListener("click", (e) => {
        if (e.target === appAlertModal) hideAlert();
      });

    let mode = "countdown"; // 'countdown' or 'stopwatch'
    const tabBtns = document.querySelectorAll(".app-tab-btn");
    const cdView = document.getElementById("countdown-view");
    const swView = document.getElementById("stopwatch-view");

    // Countdown elements
    const cdStateLabel = document.getElementById("cd-state-label");
    const cdH = document.getElementById("cd-h");
    const cdM = document.getElementById("cd-m");
    const cdS = document.getElementById("cd-s");
    const cdStartBtn = document.getElementById("cd-start");
    const cdStopBtn = document.getElementById("cd-stop");
    const cdResetBtn = document.getElementById("cd-reset");

    // Stopwatch elements
    const swDisplay = document.getElementById("sw-display");
    const swStartBtn = document.getElementById("sw-start");
    const swStopBtn = document.getElementById("sw-stop");
    const swResetBtn = document.getElementById("sw-reset");
    const swLapBtn = document.getElementById("sw-lap");
    const lapContainer = document.getElementById("lap-container");
    const lapList = document.getElementById("lap-list");

    // State
    let cdTimer = null;
    let cdTotalSeconds = 0;
    let cdRemaining = 0;
    let cdIsRunning = false;

    let swTimer = null;
    let swStartTime = 0;
    let swElapsedTime = 0;
    let swIsRunning = false;
    let swLaps = [];

    // Sound toggle
    const soundToggle = document.getElementById('sound-enabled');
    function isSoundEnabled() { return soundToggle && soundToggle.checked; }

    // Web Audio API 비프 생성 (외부 파일 불필요)
    function playBeep() {
      if (!isSoundEnabled()) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = ctx.createOscillator();
        const gainNode = ctx.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(ctx.destination);
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(880, ctx.currentTime);
        gainNode.gain.setValueAtTime(0.5, ctx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.5);
        oscillator.start(ctx.currentTime);
        oscillator.stop(ctx.currentTime + 1.5);
      } catch(e) { console.log('Web Audio not supported'); }
    }

    // 전체화면 오버레이
    const fullscreenBtn = document.getElementById('fullscreen-btn');
    const fsIconExpand = document.getElementById('fs-icon-expand');
    const fsIconCompress = document.getElementById('fs-icon-compress');
    const fsOverlay = document.getElementById('fullscreen-overlay');
    const fsTime = document.getElementById('fs-time');
    const fsLabel = document.getElementById('fs-label');
    const fsExitBtn = document.getElementById('fs-exit-btn');

    function openFullscreen() {
      if (!fsOverlay) return;
      fsOverlay.hidden = false;
      fsOverlay.requestFullscreen().catch(() => {
        // 전체화면 API 미지원 시 오버레이만 표시
      });
      fsIconExpand.style.display = 'none';
      fsIconCompress.style.display = 'block';
      updateFsDisplay();
    }

    function closeFullscreen() {
      if (!fsOverlay) return;
      fsOverlay.hidden = true;
      if (document.fullscreenElement) document.exitFullscreen();
      fsIconExpand.style.display = 'block';
      fsIconCompress.style.display = 'none';
    }

    // 오버레이 시간 동기화 (100ms마다)
    function updateFsDisplay() {
      if (fsOverlay && !fsOverlay.hidden) {
        if (mode === 'countdown') {
          const h = Math.floor(cdRemaining / 3600);
          const m = Math.floor((cdRemaining % 3600) / 60);
          const s = cdRemaining % 60;
          fsTime.textContent = h > 0
            ? `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`
            : `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
          fsLabel.textContent = '카운트다운';
        } else {
          fsTime.textContent = formatStopwatchTime(swElapsedTime);
          fsLabel.textContent = '스톱워치';
        }
        requestAnimationFrame(updateFsDisplay);
      }
    }

    if (fullscreenBtn) {
      fullscreenBtn.addEventListener('click', () => {
        if (fsOverlay && !fsOverlay.hidden) {
          closeFullscreen();
        } else {
          openFullscreen();
        }
      });
    }

    if (fsExitBtn) fsExitBtn.addEventListener('click', closeFullscreen);

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && fsOverlay && !fsOverlay.hidden) {
        closeFullscreen();
      }
    });

    function formatStopwatchTime(ms) {
      const totalDeciSeconds = Math.floor(ms / 10);
      const h = Math.floor(totalDeciSeconds / 360000);
      const m = Math.floor((totalDeciSeconds % 360000) / 6000);
      const s = Math.floor((totalDeciSeconds % 6000) / 100);
      const ds = totalDeciSeconds % 100;

      if (h > 0) {
        return `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}.${ds.toString().padStart(2, "0")}`;
      }
      return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}.${ds.toString().padStart(2, "0")}`;
    }

    // Tab Switching
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        mode = btn.dataset.target;

        if (mode === "countdown") {
          cdView.style.display = "flex";
          swView.style.display = "none";
        } else {
          cdView.style.display = "none";
          swView.style.display = "flex";
        }
      });
    });

    // === Countdown Logic ===
    function updateCdDisplay() {
      if (cdIsRunning || cdRemaining > 0) {
        const h = Math.floor(cdRemaining / 3600);
        const m = Math.floor((cdRemaining % 3600) / 60);
        const s = cdRemaining % 60;

        cdH.value = h > 0 ? h : "0";
        cdM.value = m > 0 || h > 0 ? m : "0";
        cdS.value = s;
      }
    }

    function parseCdInputs() {
      const h = parseInt(cdH.value) || 0;
      const m = parseInt(cdM.value) || 0;
      const s = parseInt(cdS.value) || 0;
      return h * 3600 + m * 60 + s;
    }

    cdStartBtn.addEventListener("click", () => {
      if (!cdIsRunning) {
        if (cdRemaining === 0) {
          cdTotalSeconds = parseCdInputs();
          cdRemaining = cdTotalSeconds;
        }

        if (cdRemaining > 0) {
          cdIsRunning = true;
          [cdH, cdM, cdS].forEach((el) => (el.disabled = true));
          cdStateLabel.style.visibility = "visible";

          cdStartBtn.style.display = "none";
          cdStopBtn.style.display = "block";

          cdTimer = setInterval(() => {
            cdRemaining--;
            updateCdDisplay();

            if (cdRemaining <= 0) {
              clearInterval(cdTimer);
              cdIsRunning = false;
              cdStartBtn.style.display = "block";
              cdStopBtn.style.display = "none";
              playBeep();
              showAlert("타이머가 종료되었습니다!");
            }
          }, 1000);
        }
      }
    });

    cdStopBtn.addEventListener("click", () => {
      if (cdIsRunning) {
        clearInterval(cdTimer);
        cdIsRunning = false;
        cdStartBtn.style.display = "block";
        cdStartBtn.textContent = "계속";
        cdStopBtn.style.display = "none";
      }
    });

    cdResetBtn.addEventListener("click", () => {
      clearInterval(cdTimer);
      cdIsRunning = false;
      cdRemaining = 0;
      cdTotalSeconds = 0;

      [cdH, cdM, cdS].forEach((el) => (el.disabled = false));
      cdStateLabel.style.visibility = "hidden";

      cdStartBtn.style.display = "block";
      cdStartBtn.textContent = "시작";
      cdStopBtn.style.display = "none";

      cdH.value = "";
      cdM.value = "";
      cdS.value = "";
    });

    // === Stopwatch Logic ===
    function updateSwDisplay() {
      swDisplay.textContent = formatStopwatchTime(swElapsedTime);
    }

    function renderLaps() {
      lapList.innerHTML = "";
      if (swLaps.length > 0) {
        lapContainer.style.display = "block";
        swLaps
          .slice()
          .reverse()
          .forEach((lap, idx) => {
            const originalIndex = swLaps.length - 1 - idx;

            const li = document.createElement("li");
            li.className = "lap-item";
            li.textContent = `${originalIndex + 1} - ${formatStopwatchTime(lap)}`;
            lapList.appendChild(li);
          });
      } else {
        lapContainer.style.display = "none";
      }
    }

    swStartBtn.addEventListener("click", () => {
      if (!swIsRunning) {
        swIsRunning = true;
        swStartTime = Date.now() - swElapsedTime;

        swStartBtn.style.display = "none";
        swStopBtn.style.display = "block";
        swResetBtn.style.display = "none";
        swLapBtn.style.display = "block";

        swTimer = setInterval(() => {
          swElapsedTime = Date.now() - swStartTime;
          updateSwDisplay();
        }, 10);
      }
    });

    swStopBtn.addEventListener("click", () => {
      if (swIsRunning) {
        swIsRunning = false;
        clearInterval(swTimer);

        swStartBtn.style.display = "block";
        swStartBtn.textContent = "계속";
        swStopBtn.style.display = "none";
        swResetBtn.style.display = "block";
        swLapBtn.style.display = "none";
      }
    });

    swLapBtn.addEventListener("click", () => {
      if (swIsRunning) {
        swLaps.push(swElapsedTime);
        renderLaps();
      }
    });

    swResetBtn.addEventListener("click", () => {
      swIsRunning = false;
      clearInterval(swTimer);
      swElapsedTime = 0;
      swLaps = [];
      updateSwDisplay();
      renderLaps();

      swStartBtn.style.display = "block";
      swStartBtn.textContent = "시작";
      swStopBtn.style.display = "none";
      swResetBtn.style.display = "block";
      swLapBtn.style.display = "none";
    });

    // Better input focus logic
    [cdH, cdM, cdS].forEach((input) => {
      input.addEventListener("focus", function () {
        if (this.value === "0" || this.value === "00") {
          this.value = "";
        } else {
          this.select();
        }
      });
      input.addEventListener("blur", function () {
        if (this.value === "") {
          this.value = ""; // Leave it blank, placeholder '0' will show
        }
      });
    });

    // Initialization
    updateCdDisplay();
    updateSwDisplay();
  });
</script>
