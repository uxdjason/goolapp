---
interface Props {
  position: 'top' | 'middle' | 'bottom';
}
const { position } = Astro.props;
const showAdsense = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const clientId    = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;

let slotId = '1234567890';
if (position === 'top') slotId = import.meta.env.PUBLIC_ADSENSE_SLOT_TOP || slotId;
if (position === 'middle') slotId = import.meta.env.PUBLIC_ADSENSE_SLOT_MIDDLE || slotId;
if (position === 'bottom') slotId = import.meta.env.PUBLIC_ADSENSE_SLOT_BOTTOM || slotId;
---
<div class={`ad-unit ad-${position}`} role="complementary" aria-label={`광고 (${position})`}>
  <p class="ad-label-text">광고</p>
  {showAdsense ? (
    <>
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client={clientId}
           data-ad-slot={slotId}
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </>
  ) : (
    <div class="ad-placeholder">
      <div class="ad-content">
        <span class="ad-label">AD UNIT</span>
        <span class="ad-pos">{position.toUpperCase()} SLOT</span>
      </div>
    </div>
  )}
</div>

<style>
  .ad-unit {
    width: 100%;
    margin: var(--space-10) 0;
    clear: both;
    /* 반응형 광고(auto)는 모바일/데스크톱 모두 최대 280px까지 뜰 수 있음.
       광고 로드 전에 공간을 미리 확보해 CLS(레이아웃 밀림)를 방지한다. */
    min-height: 280px;
  }
  /* '광고' 라벨: 광고 영역 위에 표시해 실수 클릭 유발 구조 제거 */
  .ad-label-text {
    margin: 0 0 4px;
    font-family: var(--font-family-gothic);
    font-size: 11px;
    color: var(--color-on-surface-variant, #888);
    text-align: center;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  /* Show a subtle background even for real ad tags in development/preview */
  .adsbygoogle {
    background: rgba(139, 79, 50, 0.03);
    min-height: 280px;
    display: block;
  }
  .ad-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 280px;
    background: rgba(139, 79, 50, 0.08); /* More visible background */
    border: 2px dashed rgba(139, 79, 50, 0.3);
    border-radius: var(--radius-lg);
    color: var(--color-primary);
  }
  .ad-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0.6;
  }
  .ad-label {
    font-family: var(--font-family-gothic);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.1em;
  }
  .ad-pos {
    font-family: var(--font-family-gothic);
    font-size: 11px;
    letter-spacing: 0.05em;
  }
</style>
